model content {
    id String @id @default(uuid(7))

    title             String              @db.VarChar(100)
    type              contentType
    genre             contentGenre[]
    releaseYear       Int
    synopsis          String              @db.VarChar(500)
    director          String              @db.VarChar(100)
    streamingPlatform streamingPlatform[]
    priceTier         PriceTier           @default(FREE)
    cast              String[]            @db.VarChar(100)
    youtubeVideoId    String?             @db.VarChar(20)
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt

    @@index([title], name: "idx_title")
    @@map("contents")
}
