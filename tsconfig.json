{
  "compilerOptions": {
    "module": "esnext",                                
    "rootDir": "./src",
    "outDir": "./dist",  
    "target": "es2023",
    "moduleResolution": "bundler", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true
  },
  "include" : ["src"],
  "exclude" : ["node_modules" , "dist"]
}